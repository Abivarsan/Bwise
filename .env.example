# =============================================================================
# BWise Portfolio — EmailJS Configuration (2-Template Free Tier Setup)
# =============================================================================
# Copy this file to `.env` and fill in your credentials from https://dashboard.emailjs.com/
#
# 1. Company Notification Template (Template 1):
#    - To Email: hello@bwise.lk
#    - Reply-To: {{user_email}}
#    - Subject:  {{email_subject}}
#    - Body (Source Code <>): {{{email_html}}}
#    - Auto-Reply Tab: Link to Template 2 (User Auto-Reply)
#
# 2. User Auto-Reply Template (Template 2):
#    - To Email: {{user_email}}
#    - From Name: BWise
#    - Reply-To: hello@bwise.lk
#    - Subject:  {{user_reply_subject}}
#    - Body (Source Code <>): {{{user_reply_html}}}
# =============================================================================

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_company_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
